<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Apple-only companion to FractalGpu.Rendering: the Metal backend. Needs the 'ios' and 'macos' .NET workloads. -->
    <TargetFrameworks>net10.0-ios;net10.0-macos</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatformIdentifier)' == 'macos'">12.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FractalGpu.Rendering.Metal</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FractalGpu.Rendering/FractalGpu.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/*.metal" />
  </ItemGroup>

</Project>

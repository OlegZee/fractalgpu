<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FractalGpu.BenchIos</RootNamespace>
    <ApplicationTitle>FractalGPU Bench</ApplicationTitle>
    <!-- Must match the bundle id of the dummy Xcode project that owns the free-provisioning profile; see readme. -->
    <ApplicationId>com.olegzee.fractalgpu.bench</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- NativeAOT gives RyuJIT-quality codegen (Vector<T>, deferred-log loop) so device numbers are comparable to desktop. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Automatic signing: pick whatever 'Apple Development' identity and matching profile Xcode created for the ApplicationId. -->
    <CodesignKey Condition="'$(CodesignKey)' == ''">Apple Development</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FractalGpu.Rendering/FractalGpu.Rendering.csproj" />
    <ProjectReference Include="../FractalGpu.Rendering.Metal/FractalGpu.Rendering.Metal.csproj" />
  </ItemGroup>

</Project>
